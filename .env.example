# ── Modelo ────────────────────────────────────────────────────────────
TJX_MODEL=llama3.2
TJX_HISTORY=10
TJX_KEEP_ALIVE=30m

# ── Datos locales (por defecto ~/.threat_jarvis_x) ────────────────────
# TJX_HOME=/home/tu-usuario/.threat_jarvis_x

# ── Centinela ─────────────────────────────────────────────────────────
TJX_SENTINEL=1
TJX_SENTINEL_SECS=120

# ── Iframe (Nexus) ────────────────────────────────────────────────────
TJX_EMBED_ORIGINS=http://127.0.0.1:*,http://localhost:*

# ── Nexus OSINT X ─────────────────────────────────────────────────────
NEXUS_URL=http://127.0.0.1:8000

# ── Claves API (opcionales) ───────────────────────────────────────────
VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
NVD_API_KEY=
